{
  "name": "birefs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p functions && vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && npm run db:migrate && wrangler pages dev",
    "db:migrate": "wrangler d1 migrations apply birefs --local",
    "index": "uv run --python 3.12 --with mediapipe==1.2.2 --with requests scripts/build_index.py",
    "test": "vitest run"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sass": "^1.108.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
